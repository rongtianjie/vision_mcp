# Vision MCP Server 配置
# 复制此文件为 .env，填入实际值后生效（无需重新注册 MCP）
# 完整变量说明见 README「二、配置」

# ── 默认 provider（向后兼容的 VISION_* 变量）──
VISION_API_BASE=https://api.siliconflow.cn/v1      # 视觉模型 API 地址（不含 /chat/completions）
VISION_API_KEY=sk-your-key-here                      # API 密钥（本地部署可留空）
VISION_MODEL=Qwen/Qwen2.5-VL-72B-Instruct            # 视觉模型名称
VISION_MAX_TOKENS=2000                               # 单次响应最大 token 数

# ── 可选：全局参数 ──
# VISION_TIMEOUT=120            # API 请求超时（秒）
# VISION_MAX_RETRIES=2          # 瞬时错误（429/5xx/超时）最大重试次数
# VISION_MAX_IMAGE_MB=20        # 单张图片最大体积（MB），超过拒绝
# VISION_MAX_UPLOAD_MB=8        # 超过该体积的图片自动压缩后再上传（需 Pillow，默认已安装）

# ── 可选：多后端（provider）──
# 命名 provider 的环境变量格式：VISION_PROVIDER_<NAME>_API_BASE / _API_KEY / _MODEL
# VISION_PROVIDER=default       # 默认使用的 provider 名（也可用 --provider 指定）
# VISION_PROVIDER_LOCAL_API_BASE=http://localhost:11434/v1
# VISION_PROVIDER_LOCAL_API_KEY=not-needed
# VISION_PROVIDER_LOCAL_MODEL=llava:13b
